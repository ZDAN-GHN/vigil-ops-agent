# 应用配置
APP_NAME=OnCallAgent
DEBUG=True
HOST=localhost
PORT=9999

# DashScope 配置
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-flash
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_RERANK_MODEL=qwen3-rerank
DASHSCOPE_BIZ_SPACE_API_BASE=

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置
RAG_MODEL=qwen3.7-flash

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# 支持的 transport 类型：stdio（本地进程）、streamable-http（HTTP 流）
# 也可以配置真实的cls mcp服务： https://cloud.tencent.com/developer/mcp/server/11710
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# 异步定时执行 AIOps 运维任务
ENABLE_SCHEDULED_AIOPS=False
SCHEDULED_AIOPS_INTERVAL_SECONDS=600
SCHEDULED_AIOPS_WEBHOOK_URL=https://www.baidu.com
SCHEDULED_AIOPS_SESSION_ID=_scheduled_aiops

# PostgreSQL 配置（用于冷 checkpoint fallback + Store + 对话历史持久化）
# 对话历史和长期记忆的持久化存储
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=on_call_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 长期记忆配置（用户画像特征提取）
# 启用后，Agent 会在对话前后自动加载/保存用户画像
LONG_TERM_MEMORY_ENABLED=True
# 特征提取使用的模型，留空则复用主对话模型
MEMORY_EXTRACTION_MODEL=

# Redis 配置（用于短期记忆 - 会话 checkpoint）
# 会话消息历史缓存在 Redis 中，支持重启后恢复
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# checkpoint 过期时间（秒）
REDIS_CHECKPOINT_TTL=1800

# MySQL 配置（用于鉴权和会话管理）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=on_call_agent
MYSQL_USER=root
MYSQL_PASSWORD=root

# JWT 认证配置
# 生产环境请使用随机生成的强密钥，例如: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 初始管理员配置（首次启动时自动创建，创建后可删除此配置）
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
